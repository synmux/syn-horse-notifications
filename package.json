{
  "name": "syn-horse-notifications",
  "version": "0.0.0-dev.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/synmux/syn-horse.git",
    "branch": "notifications"
  },
  "author": {
    "name": "syn",
    "email": "syn@syn.as",
    "url": "https://github.com/synmux"
  },
  "type": "module",
  "scripts": {
    "db:migrate": "wrangler d1 migrations apply syn-horse-notifications --remote",
    "db:migrate:local": "wrangler d1 migrations apply syn-horse-notifications --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "doctor:ultracite": "ultracite doctor",
    "fix": "ultracite fix",
    "fix:unsafe": "ultracite fix --unsafe",
    "format": "biome format --write .",
    "postinstall": "pnpm run types",
    "lint": "run-s lint:ultracite lint:types",
    "lint:types": "tsc --noEmit",
    "lint:ultracite": "ultracite check",
    "prepare": "skilld prepare || true",
    "start": "pnpm run dev",
    "types": "wrangler types"
  },
  "dependencies": {
    "node-gyp": "^13.1.0",
    "ntfy": "^1.15.8",
    "pushover-js": "^1.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.302",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^26.6.5",
    "ctx7": "^0.8.0",
    "npm-run-all2": "^9.0.3",
    "skilld": "^3.6.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^26.12.0"
  }
}
